<?xml version="1.0"?>
<phpunit
	bootstrap="tests/bootstrap.php"
	backupGlobals="false"
	colors="true"
	cacheDirectory=".phpunit.cache"
>
	<testsuites>
		<testsuite name="unit">
			<directory suffix="Test.php">tests/unit</directory>
		</testsuite>
	</testsuites>
	<php>
		<!-- The full suite peaks near 150 MB; PHP's CLI default is 128M (#130). -->
		<ini name="memory_limit" value="512M"/>
	</php>
</phpunit>
